<config xmlns="http://tail-f.com/ns/config/1.0">
  <high-availability xmlns="http://tail-f.com/ns/ncs">
    <token>$9$gaUuRgdZ0a9cQ317OaIZwBzbopsfDU4NkkDD7Xllw0o=</token>
    <ha-node>
      <id>n1</id>
      <address>172.18.1.2</address>
      <nominal-role>master</nominal-role>
    </ha-node>
    <ha-node>
      <id>n2</id>
      <address>172.18.2.2</address>
      <nominal-role>slave</nominal-role>
      <failover-master>true</failover-master>
    </ha-node>
    <settings>
      <enable-failover>true</enable-failover>
      <reconnect-slaves>true</reconnect-slaves>
      <start-up>
        <assume-nominal-role>false</assume-nominal-role>
        <join-ha>true</join-ha>
      </start-up>
      <reconnect-interval>10</reconnect-interval>
      <reconnect-attempts>1</reconnect-attempts>
    </settings>
  </high-availability>
  <hcc xmlns="http://cisco.com/pkg/tailf-hcc">
    <enabled>true</enabled>
    <vip-address>192.168.1.1</vip-address>
    <bgp>
      <node>
        <node-id>n1</node-id>
        <gobgp-bin-dir>/root/nso-project</gobgp-bin-dir>
        <as>65002</as>
        <router-id>172.18.1.2</router-id>
        <neighbor>
          <address>172.18.1.100</address>
          <as>65000</as>
        </neighbor>
      </node>
      <node>
        <node-id>n2</node-id>
        <gobgp-bin-dir>/root/nso-project</gobgp-bin-dir>
        <as>65003</as>
        <router-id>172.18.2.2</router-id>
        <neighbor>
          <address>172.18.2.100</address>
          <as>65000</as>
        </neighbor>
      </node>
    </bgp>
  </hcc>
</config>
